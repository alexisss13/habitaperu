// Habita Perú - Prisma Schema
// Motor LegalTech — Contratos, Firmas Digitales, Audit Trail
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  LANDLORD
  TENANT
}

enum PropertyType {
  HABITACION
  DEPARTAMENTO
  CASA
  OFICINA
  LOCAL
}

enum PropertyCondition {
  SIN_MUEBLES
  SEMI_AMOBLADO
  AMOBLADO
}

enum PropertyStatus {
  DISPONIBLE
  OCUPADA
  MANTENIMIENTO
}

/// Estados del ciclo de vida del contrato legal
enum ContractStatus {
  /// Borrador creado por el arrendador, aún no enviado
  DRAFT
  /// Enviado al inquilino, esperando su firma
  PENDING_TENANT
  /// Firmado por el inquilino, esperando contrafirma del arrendador
  PENDING_LANDLORD
  /// Contrato activo — ambas partes firmaron
  ACTIVE
  /// Contrato finalizado por vencimiento natural
  FINISHED
  /// Contrato rescindido por incumplimiento (Ley 30933)
  BREACHED_CANCELLED
}

enum PaymentStatus {
  PAGADO
  PENDIENTE
  EN_PROCESO
  VENCIDO
}

enum KYCStatus {
  PENDIENTE
  EN_REVISION
  APROBADO
  RECHAZADO
}

/// Acciones registradas en el Audit Trail criptográfico
enum AuditAction {
  /// El usuario visualizó el documento (Clickwrap — inicio del consentimiento)
  VIEWED
  /// El inquilino firmó digitalmente el contrato
  SIGNED_TENANT
  /// El arrendador contrafirmó — contrato queda ACTIVE
  COUNTERSIGNED_LANDLORD
}

// ─────────────────────────────────────────────
// MODELOS
// ─────────────────────────────────────────────

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  password           String
  firstName          String
  lastName           String
  phone              String?
  /// DNI encriptado en reposo (Ley 29733)
  dni                String?   @unique
  role               Role      @default(TENANT)
  avatar             String?
  bio                String?
  district           String?
  verified           Boolean   @default(false)
  twoFactorEnabled   Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  propertiesOwned     Property[]     @relation("PropertyOwner")
  contractsAsLandlord Contract[]     @relation("LandlordContracts")
  contractsAsTenant   Contract[]     @relation("TenantContracts")
  paymentsReceived    Payment[]      @relation("PaymentReceiver")
  paymentsMade        Payment[]      @relation("PaymentPayer")
  kycVerification     KYCVerification?
  reviewsGiven        Review[]       @relation("ReviewAuthor")
  reviewsReceived     Review[]       @relation("ReviewTarget")
  notifications       Notification[]
  sessions            Session[]
  auditLogs           AuditLog[]

  @@index([email])
  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  device    String
  location  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Property {
  id          String            @id @default(cuid())
  title       String
  description String
  type        PropertyType
  condition   PropertyCondition
  status      PropertyStatus    @default(DISPONIBLE)

  district    String
  address     String?

  area        Int?
  rooms       Int               @default(1)
  bathrooms   Int               @default(1)
  parking     Int               @default(0)

  price       Decimal           @db.Decimal(10, 2)
  deposit     Int               @default(1)
  minDuration Int               @default(12)
  availableFrom DateTime?

  amenities   Json?
  images      Json?
  tenantProfile Json?
  conditions  String?

  views       Int               @default(0)
  favorites   Int               @default(0)

  /// Campo de versión para Optimistic Concurrency Control (OCC).
  /// Antes de marcar OCUPADA, se verifica que version == version_leída.
  /// Si difiere, otro proceso ya modificó el registro → ContractConcurrencyError.
  version     Int               @default(1)

  ownerId     String
  owner       User              @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  contracts   Contract[]
  reviews     Review[]

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([type])
  @@index([district])
}

model Contract {
  id         String         @id @default(cuid())

  propertyId String
  property   Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  landlordId String
  landlord   User           @relation("LandlordContracts", fields: [landlordId], references: [id], onDelete: Cascade)

  tenantId   String
  tenant     User           @relation("TenantContracts", fields: [tenantId], references: [id], onDelete: Cascade)

  status     ContractStatus @default(DRAFT)

  monthlyRent Decimal       @db.Decimal(10, 2)
  currency    String        @default("PEN")
  startDate   DateTime
  endDate     DateTime
  /// Día del mes en que vence el pago (1-31)
  paymentDay  Int           @default(1)

  deposit     Decimal       @db.Decimal(10, 2)

  /// SHA-256 del HTML exacto que vio el usuario al firmar (Clickwrap / Ley 30201)
  documentHash String?      @unique

  terms       String?

  landlordSignedAt DateTime?
  tenantSignedAt   DateTime?

  payments    Payment[]
  auditLogs   AuditLog[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  /// Índice compuesto: consultas del dashboard por propiedad + estado
  @@index([propertyId, status])
  /// Índice compuesto: consultas del dashboard del inquilino
  @@index([tenantId, status])
  @@index([landlordId])
}

/// Registro inmutable del Audit Trail criptográfico.
/// Cada fila es una prueba legal de una acción sobre un contrato.
/// NUNCA se actualiza ni elimina — solo INSERT.
model AuditLog {
  id         String      @id @default(cuid())

  contractId String
  contract   Contract    @relation(fields: [contractId], references: [id], onDelete: Cascade)

  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  action     AuditAction

  /// IP del cliente en el momento de la acción (IPv4 o IPv6)
  ipAddress  String

  /// User-Agent completo del navegador/cliente
  userAgent  String

  /// SHA-256 del documento HTML exacto que vio el usuario al hacer clic en "Aceptar"
  cryptoHash String

  /// Timestamp en UTC — se convierte a UTC-5 (Lima) en la capa de presentación
  timestamp  DateTime    @default(now())

  @@index([contractId])
  @@index([userId])
  @@index([action])
}

model Payment {
  id          String        @id @default(cuid())

  contractId  String
  contract    Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)

  landlordId  String
  landlord    User          @relation("PaymentReceiver", fields: [landlordId], references: [id], onDelete: Cascade)

  tenantId    String
  tenant      User          @relation("PaymentPayer", fields: [tenantId], references: [id], onDelete: Cascade)

  amount      Decimal       @db.Decimal(10, 2)
  dueDate     DateTime
  paidDate    DateTime?
  status      PaymentStatus @default(PENDIENTE)

  paymentMethod String?
  receipt       String?
  notes         String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([contractId])
  @@index([landlordId])
  @@index([tenantId])
  @@index([status])
  @@index([dueDate])
}

model KYCVerification {
  id          String    @id @default(cuid())

  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  status      KYCStatus @default(PENDIENTE)

  dniVerified       Boolean @default(false)
  biometricVerified Boolean @default(false)
  backgroundCheck   Boolean @default(false)

  dniDocument       String?
  biometricData     String?
  backgroundReport  String?

  reviewNotes       String?
  verifiedAt        DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

model Review {
  id         String   @id @default(cuid())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  authorId   String
  author     User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  targetId   String
  target     User     @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)

  rating     Int
  comment    String

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([propertyId])
  @@index([authorId])
  @@index([targetId])
}

model Notification {
  id       String   @id @default(cuid())

  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     String
  title    String
  message  String
  read     Boolean  @default(false)
  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}
